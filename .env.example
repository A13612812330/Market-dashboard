# 服务与账户。首次启动时会根据 ADMIN_* 创建本地管理员。
PORT=5190
HOST=127.0.0.1
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请改成强密码
LAN_READONLY=1
LAN_GUEST_PAPER=0

# 通用文本 AI，优先读取这一组。适合 OpenAI 兼容接口。
AI_PROVIDER=Agnes
AI_API_KEY=
AI_MODEL=agnes-2.0-flash
AI_BASE_URL=https://apihub.agnes-ai.com/v1

# 兼容旧 Agnes 配置；如果上面的 AI_* 留空，会读取这一组。
# 当前工作流会优先用 Agnes 做资料汇总和排版规划。
AGNES_API_KEY=
AGNES_MODEL=agnes-2.0-flash
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# 生图模型可单独配置；留空时默认复用 AGNES_*，不会默认复用文案中转站。
IMAGE_AI_PROVIDER=
IMAGE_AI_API_KEY=
IMAGE_AI_MODEL=agnes-image-2.0-flash
IMAGE_AI_BASE_URL=
IMAGE_AI_SIZE=1024x768
IMAGE_AI_RESPONSE_FORMAT=url
IMAGE_AI_TIMEOUT_MS=60000

PYTHON_BIN=python

# 可选行情增强源：Futu 需要本机运行 OpenD；EmQuant 需要申请 Token 和安装 Python 包。
FUTU_ENABLED=1
FUTU_HOST=127.0.0.1
FUTU_PORT=11111
EMQUANT_ENABLED=0
EMQUANT_TOKEN=

# 可选：仅在启用飞书或钉钉推送时配置。不要提交真实值。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=
FEISHU_ROBOT_WEBHOOK=
FEISHU_ROBOT_SECRET=
DINGTALK_ROBOT_WEBHOOK=
DINGTALK_ROBOT_SECRET=
